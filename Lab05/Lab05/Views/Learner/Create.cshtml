@model Lab05.Models.Learner

@{
    ViewData["Title"] = "Create Learner";
}

<h1>Create New Student</h1>

<form asp-action="Create">
    <div class="form-group mb-3">
        <label asp-for="LearnerID" class="control-label"></label>
        <input asp-for="LearnerID" class="form-control" />
    </div>
    <div class="form-group mb-3">
        <label asp-for="FirstMidName" class="control-label">First Name</label>
        <input asp-for="FirstMidName" class="form-control" />
    </div>
    <div class="form-group mb-3">
        <label asp-for="LastName" class="control-label">Last Name</label>
        <input asp-for="LastName" class="form-control" />
    </div>
    <div class="form-group mb-3">
        <label asp-for="EnrollmentDate" class="control-label">Enrollment Date</label>
        <input asp-for="EnrollmentDate" type="date" class="form-control" />
    </div>
    <div class="form-group mb-3">
    <label asp-for="MajorID" class="control-label">Major</label>
    <select asp-for="MajorID" class="form-control" asp-items="ViewBag.Majors">
        <option value="">-- Select Major --</option>
    </select>
    <span asp-validation-for="MajorID" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Create" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</form>