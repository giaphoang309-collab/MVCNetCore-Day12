@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model IEnumerable<Lab05.Models.Learner>

<div class="ms-2 me-2">
    <h1>Learner List</h1>

    @await Component.InvokeAsync("Major")

    <div class="d-flex justify-content-end my-2">
        <div class="input-group" style="max-width: 300px;">
            <input id="keyword" class="form-control" name="keyword" type="text" placeholder="Search learner" />
            <button id="btnSearch" class="btn btn-primary" type="button">
                <i class="fas fa-search"></i> Tìm
            </button>
        </div>
    </div>

    <div id="content">
        @await Html.PartialAsync("LearnerTable", Model)
    </div>

    <div class="mt-3">
        <a asp-action="Create" class="btn btn-primary">Create New Student</a>
    </div>
</div>

@section Scripts {
    <script>
        $("body").on('click', '.page-item', function (e) {
            e.preventDefault();
            var page = $(this).attr('page');
            var mid = $(this).attr('mid');
            var keyword = $(this).attr('keyword');
            var data = { mid: mid, keyword: keyword, pageIndex: page };
            $.ajax({
                url: '/Learner/LearnerFilter',
                data: data,
                success: function (response) {
                    $('#content').html(response);
                }
            });
        });

        $("body").on('click', '.nav-li', function (e) {
            e.preventDefault();
            var id = $(this).attr('id');
            var data = { mid: id };
            $.ajax({
                url: '/Learner/LearnerFilter',
                data: data,
                success: function (response) {
                    $('#content').html(response);
                }
            });
        });

        $("#btnSearch").click(function (e) {
            e.preventDefault();
            var keyword = $("#keyword").val();
            var data = { keyword: keyword };
            $.ajax({
                url: '/Learner/LearnerFilter',
                data: data,
                success: function (response) {
                    $('#content').html(response);
                }
            });
        });
    </script>
}